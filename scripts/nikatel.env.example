# Nikatel panel settings - copied to /etc/nikatel/nikatel.env by the installer. Defaults in nikatel/config.py.
NIKATEL_LISTEN_HOST=0.0.0.0
NIKATEL_LISTEN_PORT=9443
NIKATEL_LOG_LEVEL=INFO
# true = the panel only reads from the servers. Turn off here (not in the UI) when repair actions are wanted.
NIKATEL_READ_ONLY=true
NIKATEL_SERVER_SAMPLE_INTERVAL=120
NIKATEL_TUNNEL_CHECK_INTERVAL=60
NIKATEL_SSH_KEY=/root/.ssh/nikatel_v2_node
