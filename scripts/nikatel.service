[Unit]
Description=Nikatel panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nikatel/nikatel.env
WorkingDirectory=/opt/nikatel/src
ExecStart=/opt/nikatel/venv/bin/nikatel serve
Restart=always
RestartSec=3
# on stop: SIGTERM only to the panel; its ssh children finish their checks while it shuts down
KillMode=mixed
TimeoutStopSec=60
ProtectSystem=full
ReadWritePaths=/var/lib/nikatel
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
